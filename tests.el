;; (setq assistant/server-url "")
(defun test-get-list-of-models () "List ollama models"
	   (let ((serverurl (concat assistant/server-url assistant/list-api)))
		 (request
		   serverurl
		   :type "GET"

		   :headers '(("Accept" . "application/json"))

		   :success (cl-function
					 (lambda (&key data &allow-other-keys)
					   (let ((modeldata (json-parse-string data :object-type 'alist))
							 (ret '()))
						 (if modeldata
							 (progn
							   (setq modeldata (cdr (assoc 'models modeldata)))
							   (setq ret (mapcar (lambda (item) (cdr (assoc 'name item)) )modeldata))
							   ))
						 (message (format "%S" ret))
						 )))

		   :error (cl-function
				   (lambda (&key error-thrown &allow-other-keys&rest _)
					 (error "Error: %S" error-thrown)
					 ))

		   :complete (lambda (&rest _) (message "Finished!")))
		 nil))


